// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User - Pemilik toko atau admin
model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  phone         String?
  password      String
  image         String?
  role          Role      @default(OWNER)
  shops         Shop[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("users")
}

// Shop - Toko barbershop
model Shop {
  id              String     @id @default(cuid())
  name            String
  slug            String     @unique // untuk subdomain
  description     String?
  phone           String
  whatsappNumber  String     // nomor WA untuk notifikasi
  address         String
  logo            String?
  bannerImage     String?
  openingTime     String     @default("09:00") // jam buka
  closingTime     String     @default("21:00") // jam tutup
  isActive        Boolean    @default(true)
  ownerId         String
  owner           User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  bookings        Booking[]
  services        Service[]
  barbers         Barber[]
  workingDays     WorkingDay[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@map("shops")
}

// Service - Layanan barbershop
model Service {
  id          String    @id @default(cuid())
  shopId      String
  shop        Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name        String
  description String?
  price       Int       // dalam rupiah
  duration    Int       @default(30) // dalam menit
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  bookings    Booking[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([shopId])
  @@map("services")
}

// Barber - Tukang cukur
model Barber {
  id          String    @id @default(cuid())
  shopId      String
  shop        Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name        String
  phone       String?
  image       String?
  isActive    Boolean   @default(true)
  bookings    Booking[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([shopId])
  @@map("barbers")
}

// Booking - Reservasi
model Booking {
  id              String        @id @default(cuid())
  shopId          String
  shop            Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  serviceId       String
  service         Service       @relation(fields: [serviceId], references: [id])
  barberId        String?
  barber          Barber?       @relation(fields: [barberId], references: [id])
  customerName    String
  customerPhone   String
  customerEmail   String?
  bookingDate     DateTime      // tanggal booking
  bookingTime     String        // format: "09:00"
  status          BookingStatus @default(PENDING)
  notes           String?
  whatsappSent    Boolean       @default(false)
  confirmationSent Boolean      @default(false)
  reminderSent     Boolean       @default(false)
  qstashMessageId  String?
  totalPrice      Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([shopId])
  @@index([shopId, bookingDate])
  @@index([shopId, status])
  @@map("bookings")
}

// WorkingDay - Hari kerja toko
model WorkingDay {
  id          String   @id @default(cuid())
  shopId      String
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  dayOfWeek   Int      // 0 = Minggu, 1 = Senin, dst
  isOpen      Boolean  @default(true)
  openTime    String?  // override jam buka
  closeTime   String?  // override jam tutup
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([shopId, dayOfWeek])
  @@map("working_days")
}

// Enum untuk role user
enum Role {
  OWNER
  ADMIN
}

// Enum untuk status booking
enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}